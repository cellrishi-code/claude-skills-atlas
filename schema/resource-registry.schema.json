{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cellrishi-code/claude-skills-atlas/schema/resource-registry.schema.json",
  "title": "Claude Skills Atlas Resource Registry",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_by": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "name",
        "path",
        "version",
        "category",
        "tags",
        "capabilities",
        "metadata"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^skills/.+/SKILL\\.md$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
